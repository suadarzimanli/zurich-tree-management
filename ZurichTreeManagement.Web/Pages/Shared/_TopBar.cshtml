@*
    Shared top bar for every page.
    ViewData["Active"]     : "map" | "desk" | "track" | "about" | "privacy"
    ViewData["ShowReport"] : true on the map (citizen "Report a tree issue" button)
    ViewData["ShowZoom"]   : true on the map (zoom badge)
    On narrow screens navigation, settings and sign-in collapse behind the menu button.
*@
@{
    var active = ViewData["Active"] as string ?? "";
    var showReport = ViewData["ShowReport"] as bool? ?? false;
    var showZoom = ViewData["ShowZoom"] as bool? ?? false;
    var signedIn = User?.Identity?.IsAuthenticated == true;
    var displayName = User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User?.Identity?.Name ?? "";
    string Cur(string key) => key == active ? "page" : "false";
}
<header class="topbar" id="topbar">
    <a class="brand" href="/" aria-label="Zurich Tree Management — map">
        <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="9" class="brand__tile" />
            <circle cx="16" cy="16" r="10" class="brand__ring" />
            <circle cx="16" cy="16" r="6.2" class="brand__ring" />
            <circle cx="16" cy="16" r="2.4" class="brand__core" />
            <path d="M16 6 L16 11" class="brand__crack" />
        </svg>
        <span class="brand__text">
            <span class="brand__name" data-i18n="app.title">Zurich Tree Management</span>
            <span class="brand__tag" data-i18n="brand.tagline">Street-tree service requests</span>
        </span>
    </a>

    <div class="topbar__tools">
        @if (showZoom)
        {
            <span class="zoom-badge" id="header-zoom-badge" data-i18n-title="header.zoom" title="Map zoom level">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <span id="header-zoom-value">15</span>
            </span>
        }
        @if (showReport)
        {
            <button type="button" id="report-start" class="btn btn--primary btn--report">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 4v6m0 2.6v.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <span class="btn__label-long" data-i18n="report.cta">Report a tree issue</span>
                <span class="btn__label-short" data-i18n="report.ctaShort">Report</span>
            </button>
        }
        <button type="button" class="topbar__menu-btn" id="topbar-menu-btn" aria-expanded="false" aria-controls="topbar-collapsible" data-i18n-aria="nav.menu" aria-label="Menu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
    </div>

    <div class="topbar__collapsible" id="topbar-collapsible">
        <nav class="topnav" aria-label="Main">
            <a href="/" class="topnav__link" aria-current="@Cur("map")" data-i18n="nav.map">Map</a>
            <a href="/ServiceRequests" class="topnav__link" aria-current="@Cur("desk")" data-i18n="nav.serviceRequests">Service requests</a>
            <a href="/Track" class="topnav__link" aria-current="@Cur("track")" data-i18n="nav.track">Track a request</a>
            <a href="/About" class="topnav__link" aria-current="@Cur("about")" data-i18n="nav.about">About</a>
        </nav>
        <div class="topbar__settings">
            <div class="seg" role="group" aria-label="Theme">
                <button type="button" id="theme-toggle-light" class="seg__btn header-toggle__btn header-toggle__btn--active" data-theme-value="light" data-i18n-title="theme.light" title="Light mode" aria-pressed="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
                <button type="button" id="theme-toggle-dark" class="seg__btn header-toggle__btn" data-theme-value="dark" data-i18n-title="theme.dark" title="Dark mode" aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7Z" fill="currentColor"/></svg>
                </button>
            </div>
            <div class="seg" role="group" aria-label="Language">
                <button type="button" id="lang-toggle-en" class="seg__btn header-toggle__btn header-toggle__btn--active" data-lang="en" aria-pressed="true">EN</button>
                <button type="button" id="lang-toggle-de" class="seg__btn header-toggle__btn" data-lang="de" aria-pressed="false">DE</button>
            </div>
            @if (signedIn)
            {
                <span class="user-chip" title="@displayName"><span class="user-chip__avatar" aria-hidden="true">@(displayName.Length > 0 ? displayName.Substring(0, 1).ToUpperInvariant() : "?")</span><span class="user-chip__name">@displayName</span></span>
                <a class="btn btn--ghost btn--sm" href="/Account/Logout" data-i18n="nav.signOut">Sign out</a>
            }
            else
            {
                <a class="btn btn--quiet btn--sm" href="/Account/Login" data-i18n="nav.signIn">Sign in</a>
            }
        </div>
    </div>
</header>
