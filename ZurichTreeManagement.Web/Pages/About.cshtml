@page
@model AboutModel
@{
    Layout = null;
    ViewData["Title"] = Model.IsGerman ? "Über die Anwendung" : "About";
}
<!DOCTYPE html>
<html lang="@(Model.IsGerman ? "de" : "en")" class="about-root" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @(Model.IsGerman ? "Zürich Baumverwaltung" : "Zurich Tree Management")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem('zurich-theme');
            if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>
</head>
<body class="about-page">
    <header class="about-topbar">
        <a class="about-topbar__back" href="/">← @(Model.IsGerman ? "Zur Karte" : "Back to map")</a>
        <div class="about-topbar__actions">
            <div class="header-toggle" role="group" aria-label="Theme">
                <button type="button" id="theme-toggle-light" class="header-toggle__btn header-toggle__btn--active" data-theme-value="light" title="@(Model.IsGerman ? "Hellmodus" : "Light mode")" aria-pressed="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <button type="button" id="theme-toggle-dark" class="header-toggle__btn" data-theme-value="dark" title="@(Model.IsGerman ? "Dunkelmodus" : "Dark mode")" aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 14.5A8.5 8.5 0 1112.5 3a6.5 6.5 0 109.5 11.5z" fill="currentColor"/></svg>
                </button>
            </div>
            <div class="header-toggle" role="group" aria-label="Language">
                <button type="button" id="lang-toggle-en" class="header-toggle__btn @(Model.IsGerman ? "" : "header-toggle__btn--active")" data-lang="en" aria-pressed="@(Model.IsGerman ? "false" : "true")">EN</button>
                <button type="button" id="lang-toggle-de" class="header-toggle__btn @(Model.IsGerman ? "header-toggle__btn--active" : "")" data-lang="de" aria-pressed="@(Model.IsGerman ? "true" : "false")">DE</button>
            </div>
        </div>
    </header>

    <main class="about-main">
        <article class="about-card">
            @if (Model.IsGerman)
            {
                <h1>Zürich Baumverwaltung</h1>
                <p class="about-lead">Kartenbasierte Anwendung für Serviceanfragen zu Stadtbäumen in Zürich — mit offiziellem Baumkataster, Workflow für Inspektion und Arbeitsauftrag, und klarer Karteninteraktion.</p>

                <section>
                    <h2>Was Sie auf der Karte tun können</h2>
                    <ul>
                        <li><strong>Bäume ansehen</strong> — offizielle Baumstandorte des Stadt Zürich Baumkatasters</li>
                        <li><strong>Links klicken</strong> (ab Zoom @Model.MinTreeClickZoom) — Bäume und Serviceanfragen im Umkreis von @Model.MapPickRadiusM&nbsp;m erkunden</li>
                        <li><strong>Rechtsklick auf einen Baum</strong> — neue Serviceanfrage erstellen</li>
                        <li><strong>SR-Pins</strong> — Workflow öffnen (ab Zoom @Model.MinSrZoom)</li>
                        <li><strong>Filter</strong> — Adresse oder Baumnummer suchen, SR-Pins laden und eingrenzen</li>
                    </ul>
                </section>

                <section>
                    <h2>Zoom &amp; Klicks</h2>
                    <table class="about-table">
                        <thead><tr><th>Zoomstufe</th><th>Verhalten</th></tr></thead>
                        <tbody>
                            <tr><td>Unter @Model.MinTreeLayerZoom</td><td>Bäume und SR-Pins ausgeblendet</td></tr>
                            <tr><td>@Model.MinTreeLayerZoom – @(Model.MinTreeClickZoom - 1)</td><td>Sichtbar, aber noch nicht klickbar (abgedunkelt)</td></tr>
                            <tr><td>@Model.MinTreeClickZoom und höher</td><td>Voll klickbar — auch Zoom 20, 21, 22 usw.</td></tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h2>Klick im @Model.MapPickRadiusM&nbsp;m-Umkreis</h2>
                    <p>Bei jedem Klick wird ein Kreis mit @Model.MapPickRadiusM&nbsp;m Radius gezeichnet. Darin werden Serviceanfragen und Bäume (Assets) gesucht — unabhängig davon, ob Sie genau auf ein Symbol geklickt haben.</p>
                    <ul>
                        <li><strong>Nichts im Kreis</strong> — nur der Kreis, kein Fenster</li>
                        <li><strong>Genau 1 Treffer</strong> — SR oder Baum öffnet sich direkt</li>
                        <li><strong>2 oder mehr</strong> — Auswahlfenster mit Anzahl und Karten (horizontal), dann Details wählen</li>
                    </ul>
                </section>

                <section>
                    <h2>Workflow</h2>
                    <p>Serviceanfrage → Inspektion → Arbeitsauftrag. Jede Phase hat eigenen Status, Priorität und Felder für das Forstteam. Farbige SR-Pins zeigen die aktuelle Phase; das Symbol im Pin zeigt die Kategorie (Schnitt, Pflanzung, Stubbe, …).</p>
                </section>

                <section>
                    <h2>Filter</h2>
                    <ul>
                        <li><strong>SRs auf Karte laden</strong> — alle offenen oder inkl. geschlossene</li>
                        <li><strong>Auf der Karte suchen</strong> — Adresse oder Baumnummer</li>
                        <li><strong>Pins eingrenzen</strong> — offen/geschlossen, Schritt, Kategorie, Priorität, Eröffnungszeitraum</li>
                    </ul>
                </section>

                <section>
                    <h2>Anmeldung (Demo)</h2>
                    <p>Für die Bearbeitung von Workflows: Administrator oder Field User — Zugangsdaten in der Projektdokumentation bzw. vom Betreiber.</p>
                </section>
            }
            else
            {
                <h1>Zurich Tree Management</h1>
                <p class="about-lead">A map-first application for tree-related service requests in the City of Zurich — official tree registry, inspection and work-order workflow, and clear map interaction.</p>

                <section>
                    <h2>What you can do on the map</h2>
                    <ul>
                        <li><strong>View trees</strong> — official street-tree locations from Stadt Zürich Baumkataster</li>
                        <li><strong>Left-click</strong> (from zoom @Model.MinTreeClickZoom) — explore trees and service requests within @Model.MapPickRadiusM&nbsp;m of your click</li>
                        <li><strong>Right-click a tree</strong> — create a new service request</li>
                        <li><strong>SR pins</strong> — open the workflow (from zoom @Model.MinSrZoom)</li>
                        <li><strong>Filters</strong> — search by address or tree number, load and narrow SR pins</li>
                    </ul>
                </section>

                <section>
                    <h2>Zoom &amp; clicks</h2>
                    <table class="about-table">
                        <thead><tr><th>Zoom level</th><th>Behaviour</th></tr></thead>
                        <tbody>
                            <tr><td>Below @Model.MinTreeLayerZoom</td><td>Trees and SR pins hidden</td></tr>
                            <tr><td>@Model.MinTreeLayerZoom – @(Model.MinTreeClickZoom - 1)</td><td>Visible but not clickable (dimmed)</td></tr>
                            <tr><td>@Model.MinTreeClickZoom and above</td><td>Fully clickable — including zoom 20, 21, 22, and beyond</td></tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h2>@Model.MapPickRadiusM&nbsp;m click area</h2>
                    <p>Every click draws a @Model.MapPickRadiusM&nbsp;m radius circle. Service requests and trees (assets) inside that circle are found — even if you did not click exactly on a symbol.</p>
                    <ul>
                        <li><strong>Nothing in the circle</strong> — circle only, no panel</li>
                        <li><strong>Exactly one match</strong> — that SR or tree opens directly</li>
                        <li><strong>Two or more</strong> — picker with counts and horizontal cards, then choose one</li>
                    </ul>
                </section>

                <section>
                    <h2>Workflow</h2>
                    <p>Service request → Inspection → Work order. Each step has its own status, priority, and fields for the forestry team. Coloured SR pins show the current phase; the icon on the pin shows the category (pruning, planting, stump, and so on).</p>
                </section>

                <section>
                    <h2>Filters</h2>
                    <ul>
                        <li><strong>Load SRs on map</strong> — open only, or include closed</li>
                        <li><strong>Find on map</strong> — address or Baumnummer (tree number)</li>
                        <li><strong>Narrow pins</strong> — open/closed, workflow step, category, priority, when opened</li>
                    </ul>
                </section>

                <section>
                    <h2>Sign in (demo)</h2>
                    <p>To process workflows, sign in as Administrator or Field User — credentials are provided in project documentation or by your operator.</p>
                </section>
            }

            <p class="about-footer-note">Tree location data © Stadt Zürich open data (OGD).</p>
        </article>
    </main>

    <script>
        window.ZURICH_PAGE = { locale: '@Model.Culture' };
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/header-controls.js" asp-append-version="true"></script>
</body>
</html>
